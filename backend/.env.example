# B1T Core RPC Settings
RPC_HOST=host.docker.internal
RPC_PORT=8332
RPC_USER=user
RPC_PASSWORD=changeme

# Server Settings
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:3000

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_GET=false

# Database (PostgreSQL)
DB_HOST=b1t-db
DB_PORT=5432
DB_USER=b1t
DB_PASSWORD=b1tpass
DB_NAME=b1twallet

# Indexer (alle Werte aus Umgebung, Fallbacks nur wenn nicht gesetzt)
INDEXER_ENABLED=true
INDEXER_START_HEIGHT=0
INDEXER_BATCH_SIZE=1000


